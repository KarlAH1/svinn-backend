# Kopier denne til .env og fyll inn verdiene

# Lokal MySQL (utvikling)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ditt_passord
DB_NAME=svinn

# Aiven MySQL (produksjon) – lim inn fra Aiven-dashbordet
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=xxxx
# DB_NAME=defaultdb
# DB_SSL=true

# JWT
JWT_SECRET=bytt_ut_med_lang_tilfeldig_streng

# Server
PORT=3000
NODE_ENV=development
